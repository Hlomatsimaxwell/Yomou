<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:background="#1A1A1A" android:gravity="center_vertical" android:id="@+id/widget_container" android:layout_height="wrap_content" android:layout_width="match_parent" android:orientation="horizontal" android:padding="8dp" xmlns:android="http://schemas.android.com/apk/res/android">

    <ImageView android:background="#333333" android:id="@+id/cover_0" android:layout_height="105dp" android:layout_width="75dp" android:scaleType="centerCrop"/>

    <ImageView android:background="#333333" android:id="@+id/cover_1" android:layout_height="105dp" android:layout_marginStart="-25dp" android:layout_width="75dp" android:scaleType="centerCrop"/>

    <ImageView android:background="#333333" android:id="@+id/cover_2" android:layout_height="105dp" android:layout_marginStart="-25dp" android:layout_width="75dp" android:scaleType="centerCrop"/>

    <ImageView android:background="#333333" android:id="@+id/cover_3" android:layout_height="105dp" android:layout_marginStart="-25dp" android:layout_width="75dp" android:scaleType="centerCrop"/>

    <TextView android:gravity="center" android:id="@+id/empty_text" android:layout_height="wrap_content" android:layout_width="match_parent" android:text="Read manga to see covers here" android:textColor="#888888" android:textSize="12sp" android:visibility="gone"/>

</LinearLayout>
